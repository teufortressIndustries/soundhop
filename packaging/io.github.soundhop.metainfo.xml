<component type="desktop-application">
  <id>io.github.soundhop</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>SoundHop</name>
  <developer id="io.github.soundhop">
    <name>SoundHop Contributors</name>
  </developer>
  <summary>Stream and share audio between local Linux and Windows machines seamlessly</summary>
  <description>
    <p>
      SoundHop wraps PipeWire, PulseAudio, and Windows WASAPI in an automatic, self-healing workflow
      with zero-configuration LAN discovery, multi-room broadcast, persistent per-app routing,
      PIN/PSK pairing, an interactive TUI, and a native desktop GUI and system tray.
    </p>
  </description>
  <launchable type="desktop-id">io.github.soundhop.desktop</launchable>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Network</category>
  </categories>
