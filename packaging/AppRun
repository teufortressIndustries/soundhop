#!/bin/sh
# ==============================================================================
# AppRun entrypoint for SoundHop v2.0 AnyLinux AppImage (sharun + dash)
# ==============================================================================
set -e

HERE="$(dirname "$(readlink -f "$0")")"

if [ -x "${HERE}/bin/soundhop" ]; then
    BIN="${HERE}/bin/soundhop"
elif [ -x "${HERE}/usr/bin/soundhop" ]; then
    BIN="${HERE}/usr/bin/soundhop"
else
    BIN="soundhop"
fi

if [ $# -eq 0 ]; then
    if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; then
        exec "$BIN" tray
    else
        exec "$BIN" status
    fi
else
    exec "$BIN" "$@"
fi
