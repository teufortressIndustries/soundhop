#!/usr/bin/env bash
# ==============================================================================
# AppRun entrypoint for SoundHop v2.0 AppImage (Pure Rust Binary)
# ==============================================================================
set -e

HERE="$(dirname "$(readlink -f "${0}")")"
export APPDIR="${HERE}"
export PATH="${HERE}/usr/bin:${PATH}"
export XDG_DATA_DIRS="${HERE}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export LD_LIBRARY_PATH="${HERE}/usr/lib:${HERE}/usr/lib64:${LD_LIBRARY_PATH:-}"

if [ $# -eq 0 ]; then
    if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; then
        exec "${HERE}/usr/bin/soundhop" tray
    else
        exec "${HERE}/usr/bin/soundhop" status
    fi
else
    exec "${HERE}/usr/bin/soundhop" "$@"
fi
