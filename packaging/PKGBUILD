# Maintainer: SoundHop Contributors <soundhop@example.com>
pkgname=soundhop
pkgver=1.1.6
pkgrel=1
pkgdesc="Seamless cross-distro local network audio sharing for Linux (PipeWire / PulseAudio)"
arch=('any')
url="https://github.com/teufortressIndustries/soundhop"
license=('MIT')
depends=('python>=3.10' 'pipewire-pulse')
optdepends=(
    'python-zeroconf: mDNS network auto-discovery'
    'pyside6: optional desktop system tray UI'
    'libnotify: desktop notifications'
)
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl

    # Install desktop entry and application icon
    install -Dm644 packaging/io.github.soundhop.desktop "$pkgdir/usr/share/applications/io.github.soundhop.desktop"
    install -Dm644 src/soundhop/assets/soundhop.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/soundhop.svg"

    # Install MIT license
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
