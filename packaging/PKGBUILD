# Maintainer: SoundHop Contributors <soundhop@example.com>
pkgname=soundhop
pkgver=2.0.3
pkgrel=1
pkgdesc="Seamless cross-distro local network audio sharing, multi-room broadcast, and Android bridge"
arch=('x86_64' 'aarch64')
url="https://github.com/teufortressIndustries/soundhop"
license=('MIT')
depends=('pipewire-pulse' 'gtk3' 'libappindicator-gtk3' 'libxdo')
optdepends=(
    'libnotify: desktop notifications'
    'scrcpy: Android audio capture bridge'
)
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --workspace
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 target/release/soundhop "$pkgdir/usr/bin/soundhop"

    install -Dm644 packaging/io.github.soundhop.desktop "$pkgdir/usr/share/applications/io.github.soundhop.desktop"
    install -Dm644 packaging/io.github.soundhop.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.soundhop.appdata.xml"
    install -Dm644 assets/soundhop.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/soundhop.svg"
    install -Dm644 assets/soundhop.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/soundhop.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
