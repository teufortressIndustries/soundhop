# Maintainer: SoundHop Contributors <https://github.com/teufortressIndustries/soundhop>
pkgname=soundhop
pkgver=2.6.2
pkgrel=1
pkgdesc="Seamless cross-distro local network audio sharing, multi-room broadcast, and Android bridge"
arch=('x86_64' 'aarch64')
url="https://github.com/teufortressIndustries/soundhop"
license=('MIT')
depends=(
    'pipewire-pulse'
    'gstreamer'
    'gst-plugins-base-libs'
    'gst-plugins-base'
    'gst-plugins-good'
    'gst-plugins-bad'
    'gtk3'
    'libappindicator-gtk3'
    'libxdo'
    'libxcb'
    'libxkbcommon'
    'libxkbcommon-x11'
    'wayland'
    'libglvnd'
)
optdepends=(
    'libnotify: desktop notifications'
    'scrcpy: Android audio capture bridge'
)
makedepends=('cargo' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --workspace
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 target/release/soundhop "$pkgdir/usr/bin/soundhop"
    install -Dm755 target/release/soundhop-gui "$pkgdir/usr/bin/soundhop-gui"

    install -Dm644 packaging/io.github.soundhop.desktop "$pkgdir/usr/share/applications/io.github.soundhop.desktop"
    install -Dm644 packaging/io.github.soundhop.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.soundhop.metainfo.xml"
    install -Dm644 assets/soundhop.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/soundhop.svg"
    install -Dm644 assets/soundhop.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/soundhop.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
